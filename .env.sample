# Copy to .env and edit. Everything below matches the verified live recipe.
IMAGE="vllm/vllm-openai-xpu@sha256:f01e24f6c7ff01f1e0662234255a1372297d1dbd89d003cf13c8fad3eab1ba4f"
CONTAINER="qwen28tp4m"
PORT=11438

# Durable locations on the B70 host — NEVER /tmp (wiped on reboot 2026-09-06)
ARTIFACTS="$HOME/xpu_artifacts"          # _xpu_C.abi3.so + libgrouped_gemm_*.so
MODEL="$HOME/models/Qwen3.8-27B-FP8"     # ~29 GB checkpoint

# Load-bearing env/flags are set inside start.sh. Read README
# "Verified live contract" before changing any of them:
#   - VLLM_XPU_FP8_BLOCK_W8A16=1 + --dtype float16   (removing = silently slower)
#   - MTP depth 5 (speculative-config; measured better than 8)
#   - ZE_AFFINITY_MASK=0,1,2,3 + per-worker spawn masks (patched executor)
#   - no CCL_ATL_TRANSPORT=ofi, no VLLM_XPU_ENABLE_XPU_GRAPH with MTP
